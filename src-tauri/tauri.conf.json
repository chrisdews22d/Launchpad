{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Launchpad",
  "version": "0.1.1",
  "identifier": "nz.launchpad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Launchpad",
      "width": 1440,
      "height": 850,
      "minWidth": 420,
      "minHeight": 560,
      "center": true,
      "backgroundColor": "#26292c"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.png", "icons/icon.ico"] }
}
